@page "/"
@using MundaBattleReport.Models
@using MundaBattleReport.Services
@inject GangImportService GangImportService
@inject BattleSessionService BattleSession
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Munda Battle Report Generator</PageTitle>

<link rel="stylesheet" href="css/index.css">

<div class="hive-container">
    <div class="hive-content">
        <div class="hive-header">
            <div class="hive-title">⬤ NECROMUNDA ⬄</div>
            <div class="hive-title subtitle">BATTLE REPORT GENERATOR</div>
            <div class="hive-subtitle">Gang Import Protocol v1.0</div>
        </div>

        <!-- Step indicator: 3 steps -->
        <div class="step-indicator">
            <div class="step-marker active">
                <span>1</span>
            </div>
            <div class="step-line active"></div>
            <div class="step-marker">
                <span>2</span>
            </div>
            <div class="step-line"></div>
            <div class="step-marker">
                <span>3</span>
            </div>
        </div>

        <!-- Gang Collection (shown when gangs imported) -->
        @if (BattleSession.Gangs.Count > 0)
        {
            <div class="import-card">
                <div class="card-title">Battle Roster</div>
                <div class="gang-collection">
                    @foreach (var (gang, index) in BattleSession.Gangs.Select((g, i) => (g, i)))
                    {
                        <div class="gang-card">
                            <div class="gang-card__number">GANG @(index + 1)</div>
                            <div class="gang-card__info">
                                <div class="gang-card__name">@gang.Name</div>
                                <div class="gang-card__details">@gang.House — @gang.Fighters.Count fighters</div>
                            </div>
                            <button class="gang-card__remove" @onclick="() => RemoveGang(gang.Id)" title="Remove this gang">✕</button>
                        </div>
                    }
                </div>
            </div>
        }

        @if (PendingGang == null)
        {
            <!-- Step 1: Import screen -->
            <div class="import-card">
                <div class="card-title">@(BattleSession.Gangs.Count > 0 ? "Import Another Gang" : "Import Gang Data")</div>

                <div class="input-section">
                    <label class="input-label">Gang Information (JSON Format)</label>
                    <textarea
                        @bind="GangInput"
                        class="gang-input mud-input-root mud-input-root-outlined"
                        placeholder="Paste JSON gang data here..."></textarea>
                </div>

                <div class="info-note">
                    <strong>Note:</strong> Paste valid JSON gang data. Example format includes fighter names, stats, weapons, and equipment.
                </div>

                <div class="button-group">
                    <button class="action-button action-button-primary mud-button-root"
                        @onclick="ImportGang"
                        disabled="@(IsLoading || string.IsNullOrWhiteSpace(GangInput))">
                        @if (IsLoading)
                        {
                            <span class="loading-text">⟳ Importing...</span>
                        }
                        else
                        {
                            <span>⬥ Scan Data</span>
                        }
                    </button>
                    <button class="action-button action-button-secondary mud-button-root"
                        @onclick="LoadSampleGang">
                        ⬤ Load Sample
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Step 2: Verify screen -->
            <div class="import-card">
                <div class="card-title">Verify Gang Records</div>

                <div class="success-banner">
                    <strong>✓ SCAN COMPLETE</strong> — Gang loaded: <span class="text-gold">@PendingGang.Name</span> <span class="text-subtle">(@PendingGang.House)</span>
                </div>

                <div class="section-divider">
                    <div class="card-title card-title-spacing">Fighter Roster</div>
                    <MudTable Items="PendingGang.Fighters" Hover="true" Dense="true" Class="fighter-table">
                        <HeaderContent>
                            <MudTh>Fighter</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Stats</MudTh>
                            <MudTh>Equipment</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Fighter">
                                <span class="text-gold">@context.FighterName</span>
                            </MudTd>
                            <MudTd DataLabel="Type">@context.FighterType</MudTd>
                            <MudTd DataLabel="Stats">
                                <span class="text-stat">@context.WeaponSkill</span>/<span class="text-stat">@context.BallisticSkill</span>
                            </MudTd>
                            <MudTd DataLabel="Equipment">
                                @if (context.Weapons.Any())
                                {
                                    @string.Join(", ", context.Weapons.Select(w => w.Name))
                                }
                                else
                                {
                                    <em class="text-muted-dim">—</em>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <div class="section-divider">
                    <div class="card-title card-title-spacing">Gang Configuration</div>
                    <div class="config-grid">
                        <div class="form-field">
                            <label class="form-label">Gang Name</label>
                            <input type="text" @bind="PendingGang.Name" class="form-input mud-input-root mud-input-root-outlined" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">House</label>
                            <input type="text" @bind="PendingGang.House" class="form-input mud-input-root mud-input-root-outlined" />
                        </div>
                    </div>
                </div>

                <div class="info-note text-center">
                    Data verified and ready for battle documentation.
                </div>

                <div class="button-group">
                    <button class="action-button action-button-secondary mud-button-root"
                        @onclick="ResetImport">
                        ⬄ Import New Gang
                    </button>
                    <button class="action-button action-button-primary mud-button-root"
                        @onclick="AddToBattle">
                        ⬥ Add to Battle
                    </button>
                </div>
            </div>
        }

        <!-- Proceed section (footer) -->
        @if (BattleSession.Gangs.Count > 0)
        {
            <div class="proceed-section">
                @if (!BattleSession.CanProceed)
                {
                    <div class="gang-count-hint">
                        ⟳ Import at least @(2 - BattleSession.Gangs.Count) more gang(s) to proceed
                    </div>
                }
                <button class="action-button action-button-primary mud-button-root"
                    @onclick="ProceedToNextStep"
                    disabled="@(!BattleSession.CanProceed)">
                    ▶ Proceed to Battle Setup
                </button>
            </div>
        }
    </div>
</div>

@code {
    private string GangInput = "";
    private Gang? PendingGang = null;
    private bool IsLoading = false;

    private async Task ImportGang()
    {
        if (string.IsNullOrWhiteSpace(GangInput))
            return;

        IsLoading = true;
        try
        {
            var (success, gang, errorMessage) = await GangImportService.ImportGangAsync(GangInput);

            if (success && gang != null)
            {
                PendingGang = gang;
                Snackbar.Add("Gang imported successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void AddToBattle()
    {
        if (PendingGang != null)
        {
            BattleSession.AddGang(PendingGang);
            Snackbar.Add($"Gang added to battle: {PendingGang.Name}", Severity.Success);
            PendingGang = null;
            GangInput = "";
        }
    }

    private void RemoveGang(Guid id)
    {
        BattleSession.RemoveGang(id);
        Snackbar.Add("Gang removed from battle", Severity.Info);
    }

    private void ResetImport()
    {
        PendingGang = null;
        GangInput = "";
    }

    private void ProceedToNextStep()
    {
        if (BattleSession.CanProceed)
        {
            NavigationManager.NavigateTo("/battle-setup");
        }
    }

    private void LoadSampleGang()
    {
        var (success, gang, errorMessage) = GangImportService.GenerateSampleGang();
        if (success && gang != null)
        {
            PendingGang = gang;
            Snackbar.Add("Sample gang loaded for testing", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to load sample gang", Severity.Error);
        }
    }

}
