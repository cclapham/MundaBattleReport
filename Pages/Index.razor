@page "/"
@using MundaBattleReport.Models
@using MundaBattleReport.Services
@inject GangImportService GangImportService
@inject ISnackbar Snackbar

<PageTitle>Munda Battle Report Generator</PageTitle>

<link rel="stylesheet" href="css/index.css">

<div class="hive-container">
    <div class="hive-content">
        <div class="hive-header">
            <div class="hive-title">⬤ NECROMUNDA ⬤</div>
            <div class="hive-title" style="font-size: 1.5rem; margin-bottom: 1rem;">BATTLE REPORT GENERATOR</div>
            <div class="hive-subtitle">Gang Import Protocol v1.0</div>
        </div>

        @if (ImportedGang == null)
        {
            <div class="step-indicator">
                <div class="step-marker active">
                    <span>1</span>
                </div>
                <div class="step-line"></div>
                <div class="step-marker">
                    <span>2</span>
                </div>
            </div>

            <div class="import-card" style="padding: 2rem;">
                <div class="card-title">Import Gang Data</div>

                <div class="input-section">
                    <label class="input-label">Gang Information (JSON Format)</label>
                    <textarea
                        @bind="GangInput"
                        class="gang-input mud-input-root mud-input-root-outlined"
                        style="width: 100%; min-height: 150px; padding: 1rem; border-radius: 4px; resize: vertical;"
                        placeholder="Paste JSON gang data here..."></textarea>
                </div>

                <div style="margin-bottom: 1.5rem; color: #999; font-size: 0.85rem; line-height: 1.5;">
                    <strong style="color: #bbb;">Note:</strong> Paste valid JSON gang data. Example format includes fighter names, stats, weapons, and equipment.
                </div>

                <div class="button-group">
                    <button class="action-button action-button-primary mud-button-root"
                        @onclick="ImportGang"
                        disabled="@(IsLoading || string.IsNullOrWhiteSpace(GangInput))"
                        style="cursor: @(IsLoading || string.IsNullOrWhiteSpace(GangInput) ? "not-allowed" : "pointer"); opacity: @(IsLoading || string.IsNullOrWhiteSpace(GangInput) ? 0.5 : 1);">
                        @if (IsLoading)
                        {
                            <span class="loading-text">⟳ Importing...</span>
                        }
                        else
                        {
                            <span>⬥ Scan Data</span>
                        }
                    </button>
                    <button class="action-button action-button-secondary mud-button-root"
                        @onclick="LoadSampleGang">
                        ⬤ Load Sample
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="step-indicator">
                <div class="step-marker active">
                    <span>1</span>
                </div>
                <div class="step-line active"></div>
                <div class="step-marker active">
                    <span>2</span>
                </div>
            </div>

            <div class="import-card" style="padding: 2rem;">
                <div class="card-title">Verify Gang Records</div>

                <div class="success-banner" style="padding: 1rem; margin-bottom: 1.5rem; border-radius: 4px;">
                    <strong>✓ SCAN COMPLETE</strong> — Gang loaded: <span style="color: #ffed4e;">@ImportedGang.Name</span> <span style="color: #aaa;">(@ImportedGang.House)</span>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <div class="card-title" style="margin-bottom: 1rem;">Fighter Roster</div>
                    <MudTable Items="ImportedGang.Fighters" Hover="true" Dense="true" Class="fighter-table">
                        <HeaderContent>
                            <MudTh>Fighter</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Stats</MudTh>
                            <MudTh>Equipment</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Fighter">
                                <span style="color: #ffed4e;">@context.FighterName</span>
                            </MudTd>
                            <MudTd DataLabel="Type">@context.FighterType</MudTd>
                            <MudTd DataLabel="Stats">
                                <span style="color: #81c784;">@context.WeaponSkill</span>/<span style="color: #81c784;">@context.BallisticSkill</span>
                            </MudTd>
                            <MudTd DataLabel="Equipment">
                                @if (context.Weapons.Any())
                                {
                                    @string.Join(", ", context.Weapons.Select(w => w.Name))
                                }
                                else
                                {
                                    <em style="color: #666;">—</em>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <div class="card-title" style="margin-bottom: 1rem;">Gang Configuration</div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-field">
                            <label class="form-label">Gang Name</label>
                            <input type="text" @bind="ImportedGang.Name" class="form-input mud-input-root mud-input-root-outlined" style="width: 100%; padding: 0.75rem; border-radius: 4px;" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">House</label>
                            <input type="text" @bind="ImportedGang.House" class="form-input mud-input-root mud-input-root-outlined" style="width: 100%; padding: 0.75rem; border-radius: 4px;" />
                        </div>
                    </div>
                </div>

                <div style="color: #999; font-size: 0.85rem; margin-bottom: 1.5rem; text-align: center;">
                    Data verified and ready for battle documentation.
                </div>

                <div class="button-group">
                    <button class="action-button action-button-secondary mud-button-root"
                        @onclick="ResetImport">
                        ⬄ Import New Gang
                    </button>
                    <button class="action-button action-button-primary mud-button-root"
                        @onclick="ProceedToNextStep">
                        ► Proceed to Battle
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string GangInput = "";
    private Gang? ImportedGang = null;
    private bool IsLoading = false;

    private async Task ImportGang()
    {
        if (string.IsNullOrWhiteSpace(GangInput))
            return;

        IsLoading = true;
        try
        {
            var (success, gang, errorMessage) = await GangImportService.ImportGangAsync(GangInput);

            if (success && gang != null)
            {
                ImportedGang = gang;
                Snackbar.Add("Gang imported successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ResetImport()
    {
        ImportedGang = null;
        GangInput = "";
    }

    private void ProceedToNextStep()
    {
        if (ImportedGang != null)
        {
            // TODO: Store gang in session state and navigate to BattleSetup.razor
            Snackbar.Add("Feature coming soon: Battle setup", Severity.Info);
        }
    }

    private void LoadSampleGang()
    {
        var (success, gang, errorMessage) = GangImportService.GenerateSampleGang();
        if (success && gang != null)
        {
            ImportedGang = gang;
            Snackbar.Add("Sample gang loaded for testing", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to load sample gang", Severity.Error);
        }
    }

}
