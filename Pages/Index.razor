@page "/"
@using MundaBattleReport.Models
@using MundaBattleReport.Services
@inject GangImportService GangImportService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Munda Battle Report Generator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudText Typo="Typo.h3" Class="mb-4">Necromunda Battle Report Generator</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">Import your gang from Munda Manager and generate cinematic battle narratives.</MudText>

    @if (ImportedGang == null)
    {
        <MudCard Class="mb-6">
            <MudCardContent>
                <MudText Typo="Typo.h5" Class="mb-4">Step 1: Import Your Gang</MudText>

                <MudTextField
                    @bind-Value="GangInput"
                    Label="Munda Manager Share Link or JSON Export"
                    Placeholder="Paste a Munda Manager share link or JSON data"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Lines="4"
                    Class="mb-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Option 1: Login to Munda Manager</MudText>
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    Size="Size.Large"
                    FullWidth="true"
                    Class="mb-4"
                    OnClick="OpenMundaLoginModal">
                    Login & Import from Munda Manager
                </MudButton>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Option 2: Paste Gang Data Manually</MudText>
                <MudTextField
                    @bind-Value="GangInput"
                    Label="JSON Data"
                    Placeholder="Paste JSON gang data"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Lines="3"
                    Class="mb-4" />

                <MudStack Row="true" Spacing="2" Class="mb-4">
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        Size="Size.Large"
                        FullWidth="true"
                        OnClick="ImportGang"
                        Disabled="IsLoading || string.IsNullOrWhiteSpace(GangInput)">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Importing...</MudText>
                        }
                        else
                        {
                            <MudText>Import Gang</MudText>
                        }
                    </MudButton>
                    <MudButton
                        Variant="Variant.Outlined"
                        Color="Color.Default"
                        Size="Size.Large"
                        OnClick="LoadSampleGang">
                        Load Sample Data
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5" Class="mb-4">Step 2: Verify Gang Data</MudText>

                <MudAlert Severity="Severity.Success" Class="mb-4">
                    Successfully imported <strong>@ImportedGang.Name</strong> (@ImportedGang.House)
                </MudAlert>

                <MudText Typo="Typo.subtitle2" Class="mb-3">Gang Roster</MudText>

                <MudTable Items="ImportedGang.Fighters" Hover="true" Dense="true" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Fighter Name</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>WS/BS</MudTh>
                        <MudTh>Equipment</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.FighterName</MudTd>
                        <MudTd DataLabel="Type">@context.FighterType</MudTd>
                        <MudTd DataLabel="WS/BS">@context.WeaponSkill/@context.BallisticSkill</MudTd>
                        <MudTd DataLabel="Equipment">
                            @if (context.Weapons.Any())
                            {
                                @string.Join(", ", context.Weapons.Select(w => w.Name))
                            }
                            else
                            {
                                <em>No weapons</em>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Gang Details</MudText>
                <MudGrid Class="mb-4">
                    <MudItem xs="6">
                        <MudTextField
                            @bind-Value="ImportedGang.Name"
                            Label="Gang Name"
                            Variant="Variant.Outlined"
                            FullWidth="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField
                            @bind-Value="ImportedGang.House"
                            Label="House"
                            Variant="Variant.Outlined"
                            FullWidth="true" />
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.caption" Class="mb-4">
                    ✓ Gang data is ready. Proceed to battle logging next.
                </MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton
                        Variant="Variant.Outlined"
                        Color="Color.Default"
                        OnClick="ResetImport">
                        Import Different Gang
                    </MudButton>
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        OnClick="ProceedToNextStep">
                        Continue to Battle Setup
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@if (ShowMundaModal)
{
    <MudOverlay Visible="ShowMundaModal" OnClick="CloseMundaModal" DarkBackground="true" />
    <MudPaper Class="pa-6" Style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 900px; max-height: 90vh; overflow-y: auto; z-index: 1301;">
        <MudText Typo="Typo.h6" Class="mb-4">Login to Munda Manager & Extract Gang Data</MudText>

        <MudAlert Severity="Severity.Info" Class="mb-4">
            <strong>Instructions:</strong>
            <ol>
                <li>Log in to Munda Manager (if needed)</li>
                <li>Navigate to your gang page</li>
                <li>Click the "Extract Gang Data" button below</li>
            </ol>
        </MudAlert>

        <div style="border: 1px solid #ccc; border-radius: 4px; overflow: hidden; margin-bottom: 16px;">
            <iframe
                id="munda-iframe"
                src="https://www.mundamanager.com/"
                style="width: 100%; height: 500px; border: none;">
            </iframe>
        </div>

        @if (MundaExtractionError != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @MundaExtractionError
            </MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton OnClick="CloseMundaModal">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExtractGangFromMunda">
                Extract Gang Data
            </MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private string GangInput = "";
    private Gang? ImportedGang = null;
    private bool IsLoading = false;
    private bool ShowMundaModal = false;
    private string? MundaExtractionError = null;

    private async Task ImportGang()
    {
        if (string.IsNullOrWhiteSpace(GangInput))
            return;

        IsLoading = true;
        try
        {
            var (success, gang, errorMessage) = await GangImportService.ImportGangAsync(GangInput);

            if (success && gang != null)
            {
                ImportedGang = gang;
                Snackbar.Add("Gang imported successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ResetImport()
    {
        ImportedGang = null;
        GangInput = "";
    }

    private void ProceedToNextStep()
    {
        if (ImportedGang != null)
        {
            // TODO: Store gang in session state and navigate to BattleSetup.razor
            Snackbar.Add("Feature coming soon: Battle setup", Severity.Info);
        }
    }

    private void LoadSampleGang()
    {
        var (success, gang, errorMessage) = GangImportService.GenerateSampleGang();
        if (success && gang != null)
        {
            ImportedGang = gang;
            Snackbar.Add("Sample gang loaded for testing", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to load sample gang", Severity.Error);
        }
    }

    private void OpenMundaLoginModal()
    {
        ShowMundaModal = true;
        MundaExtractionError = null;
    }

    private void CloseMundaModal()
    {
        ShowMundaModal = false;
    }

    private async Task ExtractGangFromMunda()
    {
        try
        {
            MundaExtractionError = null;
            IsLoading = true;

            var extractedJson = await JS.InvokeAsync<string>("extractGangDataFromIframe");

            if (string.IsNullOrEmpty(extractedJson))
            {
                MundaExtractionError = "No gang data found. Make sure you're viewing a gang page in Munda Manager.";
                return;
            }

            // Process the extracted JSON
            GangInput = extractedJson;
            var (success, gang, errorMessage) = await GangImportService.ImportGangAsync(extractedJson);

            if (success && gang != null)
            {
                ImportedGang = gang;
                ShowMundaModal = false;
                Snackbar.Add("Gang imported successfully from Munda Manager!", Severity.Success);
            }
            else
            {
                MundaExtractionError = errorMessage;
            }
        }
        catch (Exception ex)
        {
            MundaExtractionError = $"Error extracting gang data: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
